# Copy to .env and fill in the providers you actually use.
# The runner only needs keys for the models listed in config/models.json —
# models whose key is missing are skipped with a warning, not failed.

# Claude Opus 5 / Sonnet 5 / Haiku 4.5, and the judge quorum.
ANTHROPIC_API_KEY=

# GLM 5.2, direct to Z.ai (uses your GLM subscription).
GLM_API_KEY=

# GPT-5.6 Sol / Terra / Luna, Grok 4.5, Kimi K3.
OPENROUTER_API_KEY=

# Qwen 3.8 Max Preview, direct to Alibaba DashScope.
DASHSCOPE_API_KEY=
