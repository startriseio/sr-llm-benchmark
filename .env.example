# Copy to .env and fill in the providers you actually use.
# The runner only needs keys for the models listed in config/models.json —
# models whose key is missing are skipped with a warning, not failed.

# Anthropic models (direct) and the Craft judge.
ANTHROPIC_API_KEY=

# Everything else in the default roster routes through OpenRouter with one key:
# OpenAI, xAI, Z.ai, DeepSeek, Moonshot, Alibaba, Meta, Google — and the Engineering and Brief judges.
OPENROUTER_API_KEY=

# Optional direct routes. Swap a model's baseURL/apiKeyEnv in config/models.json to use them.
GLM_API_KEY=
DASHSCOPE_API_KEY=
