{
  "name": "sr-llm-benchmark",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The Startrise LLM Benchmark \u2014 frontier models build the same twelve real frontends, single-shot; gated in a real browser, judged blind by a cross-lab panel, rated blind by a human.",
  "scripts": {
    "test": "node scripts/validate-config.mjs",
    "start": "node src/cli.mjs",
    "gen": "node src/generate.mjs",
    "gates": "node src/gates.mjs",
    "judge": "node src/judge.mjs",
    "score": "node src/score.mjs",
    "audit": "node src/audit.mjs",
    "manual": "node src/manual.mjs",
    "report": "node src/report.mjs",
    "bench": "node src/bench.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^17.0.0",
    "openai": "^6.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://www.startrise.io/benchmark/",
  "repository": {
    "type": "git",
    "url": "https://github.com/startriseio/sr-llm-benchmark.git"
  },
  "bugs": {
    "url": "https://github.com/startriseio/sr-llm-benchmark/issues"
  },
